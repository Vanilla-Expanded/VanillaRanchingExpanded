<Defs>
	<HediffDef>
		<defName>VRE_VerySlowMetabolism</defName>
		<label>very slow metabolism</label>
		<description>This is a hidden hediff that modifies the animal's hunger depending on animal genes.</description>
		<defaultLabelColor>(.8,0,0)</defaultLabelColor>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<allowMothballIfLowPriorityWorldPawn>true</allowMothballIfLowPriorityWorldPawn>
		<maxSeverity>1.0</maxSeverity>
		<stages>
			<li>
				<minSeverity>0</minSeverity>
				<becomeVisible>false</becomeVisible>
				<hungerRateFactor>0.5</hungerRateFactor>
			</li>
		</stages>
	</HediffDef>
