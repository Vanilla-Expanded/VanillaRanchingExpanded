<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="AnimalThingBase">
		<defName>VRE_HorseDraft</defName>
		<label>draft horse</label>
		<description>A massive, muscular horse breed specifically bred for heavy labor, plowing, and hauling enormous loads. What the draft horse lacks in speed, it more than makes up for with its immense body size, impressive muscularity, and unmatched carrying capacity.</description>
		<statBases>
			<MoveSpeed>4.2</MoveSpeed>
			<MarketValue>700</MarketValue>
			<ComfyTemperatureMin>-35</ComfyTemperatureMin>
			<ComfyTemperatureMax>45</ComfyTemperatureMax>
			<FilthRate>20</FilthRate>
			<CaravanRidingSpeedFactor>1.2</CaravanRidingSpeedFactor>
			<Wildness>0.25</Wildness>
		</statBases>
		<comps>
			<li Class="VEF.AnimalGenes.CompProperties_AnimalGenes">      
			</li>
		</comps>
		<race>
			<herdAnimal>true</herdAnimal>
			<body>QuadrupedAnimalWithHooves</body>
			<baseBodySize>3</baseBodySize>
			<baseHealthScale>2.2</baseHealthScale>
			<baseHungerRate>0.75</baseHungerRate>
			<foodType>VegetarianRoughAnimal</foodType>
			<leatherDef>Leather_Plain</leatherDef>
			<gestationPeriodDays>6.66</gestationPeriodDays>
			<roamMtbDays>2</roamMtbDays>
			<trainability>Intermediate</trainability>
			<useMeatFrom>Horse</useMeatFrom>
			<packAnimal>true</packAnimal>
			<lifeExpectancy>30</lifeExpectancy>
			<lifeStageAges>
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>0.25</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.3333</minAge>
					<soundWounded>Pawn_Horse_Wounded</soundWounded>
					<soundDeath>Pawn_Horse_Death</soundDeath>
					<soundCall>Pawn_Horse_Call</soundCall>
					<soundAngry>Pawn_Horse_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
			<soundEating>Herbivore_Eat</soundEating>
			<headPosPerRotation>
				<li>(0.0, 0, 0.33)</li>
				<li>(0.31, 0, 0.21)</li>
				<li>(0.0, 0, 0.08)</li>
				<li>(-0.31, 0, 0.21)</li>
			</headPosPerRotation>
			<canCrossBreedWith>
				<li>Horse</li>
				<li>VRE_HorseArabian</li>
				<li>VRE_HorseKonik</li>
				<li>Donkey</li>
			</canCrossBreedWith>
		</race>
		<modExtensions>
			<li Class="VEF.AnimalBehaviours.AnimalCrossbreedExtension">
				<crossBreedKindDef>Random</crossBreedKindDef>
				<weightForMother>0.6</weightForMother>
				<specificCombinationsOverride>
					<combinations>
						<li>
							<firstparent>VRE_HorseDraft</firstparent>
							<secondparent>Donkey</secondparent>
							<offspring>VRE_Mule</offspring>
						</li>
					</combinations>
				</specificCombinationsOverride>
			</li>
		</modExtensions>
		<tradeTags>
			<li>AnimalCommon</li>
			<li>AnimalFarmUncommon</li>
		</tradeTags>
		<tools>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>12</power>
				<cooldownTime>2.9</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
			<li>
				<label>left hoof</label>
				<labelNoLocation>hoof</labelNoLocation>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
			</li>
			<li>
				<label>right hoof</label>
				<labelNoLocation>hoof</labelNoLocation>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
