<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Horse"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Horse"]</xpath>
			<value>
				<comps/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Horse"]/comps</xpath>
		<value>
			<li Class="VEF.AnimalGenes.CompProperties_AnimalGenes">      
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Horse"]/race</xpath>
		<value>
			<canCrossBreedWith>
				<li>VRE_HorseArabian</li>
				<li>VRE_HorseDraft</li>
				<li>VRE_HorseKonik</li>
				<li>Donkey</li>
			</canCrossBreedWith>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="Horse"]</xpath>
		<value>
			<li Class="VEF.AnimalBehaviours.AnimalCrossbreedExtension">
				<crossBreedKindDef>Random</crossBreedKindDef>
				<weightForMother>0.6</weightForMother>
				<specificCombinationsOverride>
					<combinations>
						<li>
							<firstparent>Horse</firstparent>
							<secondparent>Donkey</secondparent>
							<offspring>VRE_Mule</offspring>
						</li>
					</combinations>
				</specificCombinationsOverride>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
