<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Alpaca"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Sheep"]</xpath>
			<value>
				<comps/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Alpaca"]/comps</xpath>
		<value>
			<li Class="VEF.AnimalGenes.CompProperties_AnimalGenes">      
			</li>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Dromedary"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Dromedary"]</xpath>
			<value>
				<comps/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dromedary"]/comps</xpath>
		<value>
			<li Class="VEF.AnimalGenes.CompProperties_AnimalGenes">      
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dromedary"]/race</xpath>
		<value>
			<canCrossBreedWith>
				<li MayRequire="VanillaExpanded.VanillaAnimalsExpanded">AEXP_Camel</li>
				
			</canCrossBreedWith>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="Dromedary"]</xpath>
		<value>
			<li Class="VEF.AnimalBehaviours.AnimalCrossbreedExtension">
				<crossBreedKindDef>Random</crossBreedKindDef>
				<weightForMother>0.6</weightForMother>
			</li>
		</value>
	</Operation>
</Patch>

