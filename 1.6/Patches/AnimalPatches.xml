<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Cow"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Cow"]</xpath>
			<value>
				<comps/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Cow"]/comps</xpath>
		<value>
			<li Class="VanillaRanchingExpanded.CompProperties_AnimalGenes">      
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[defName="Cow"]/lifeStages/li[1]/bodyGraphicData/texPath</xpath>
		<value>
			<texPath>Pawn/CowsBabies/CowBaby</texPath>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[defName="Cow"]/lifeStages/li[1]/femaleGraphicData/texPath</xpath>
		<value>
			<texPath>Pawn/CowsBabies/CowBaby</texPath>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Muffalo"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Muffalo"]</xpath>
			<value>
				<comps/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Muffalo"]/comps</xpath>
		<value>
			<li Class="VanillaRanchingExpanded.CompProperties_AnimalGenes">      
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Muffalo"]/comps/li[@Class="CompProperties_Milkable"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Muffalo"]/comps</xpath>
			<value>
				<li Class="CompProperties_Milkable">
					<milkDef>Milk</milkDef>
					<milkIntervalDays>1</milkIntervalDays>
					<milkAmount>10</milkAmount>
				</li>
			</value>
		</nomatch>
	</Operation>
</Patch>

