			<li Class="VEF.AnimalGenes.CompProperties_AnimalGenes">      
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="AEXP_EggWildGooseFertilized"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="AEXP_EggWildGooseFertilized"]</xpath>
			<value>
				<comps/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AEXP_EggWildGooseFertilized"]/comps</xpath>
		<value>
			<li Class="VEF.AnimalGenes.CompProperties_AnimalGenes">      
			</li>
			<li Class="VEF.AnimalGenes.CompProperties_StackByGenes">      
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="AEXP_EggWildGooseFertilized"]/inspectorTabs</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="AEXP_EggWildGooseFertilized"]</xpath>
			<value>
				<inspectorTabs/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AEXP_EggWildGooseFertilized"]/inspectorTabs</xpath>
		<value>
			<li>VEF.AnimalGenes.ITab_AnimalGenes</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AEXP_WildGoose"]/race</xpath>
		<value>
			<canCrossBreedWith>
				
				<li>Goose</li>
			</canCrossBreedWith>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="AEXP_WildGoose"]</xpath>
		<value>
			<li Class="VEF.AnimalBehaviours.AnimalCrossbreedExtension">
				<crossBreedKindDef>Random</crossBreedKindDef>
				<weightForMother>0.6</weightForMother>
			</li>
		</value>
