<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputPath>../Assemblies</OutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>None</DebugType>
    <LangVersion>latest</LangVersion>
    <Nullable>warnings</Nullable>
	  <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GameAssemblyDirectory Condition="'$(GameAssemblyDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</GameAssemblyDirectory>
    <FrameworkAssemblyPath Condition="'$(FrameworkAssemblyPath)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\VanillaExpandedFramework\1.7\Assemblies\VEF.dll</FrameworkAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony">
      <Version>*</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameAssemblyDirectory)\Assembly-CSharp.dll</HintPath>
      <CopyLocal>false</CopyLocal>
      <Private>false</Private>
    </Reference>

    <Reference Include="RimWorld">
      <HintPath>$(GameAssemblyDirectory)\RimWorld.dll</HintPath>
	   <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameAssemblyDirectory)\UnityStubs.dll</HintPath>
	   <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
    <Reference Include="VEF">
      <HintPath>$(FrameworkAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(GameAssemblyDirectory)\Waylith.dll</HintPath>
	   <CopyLocal>false</CopyLocal>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="KillRimWorld" BeforeTargets="BeforeCompile" Condition="'$(KillRunningRimWorld)' == 'true'">
    <Exec Command="taskkill /F /IM RimWorld.exe" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
  </Target>
</Project>
